# APP
APP_NAME=SimuLearn
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DEFAULT_LANGUAGE=fr

# DATABASE (docker compose : postgresql+psycopg://simulearn:CHANGE_ME@postgres:5432/simulearn)
DATABASE_URL=
POSTGRES_PASSWORD=

# AUTH
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
# Développement local uniquement : jetons "dev:<email>:<role>" sans Keycloak. Jamais en production.
AUTH_DEV_MODE=false

# OPENAI GPT-LIVE
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=sillage
# openai_live | mock (mock = aucune API distante, texte uniquement, développement)
VOICE_PROVIDER=openai_live

# ANTHROPIC
ANTHROPIC_API_KEY=
ANTHROPIC_EVALUATION_MODEL=claude-sonnet-5-5
ANTHROPIC_SCENARIO_MODEL=claude-sonnet-5-5
# claude | mock
EVALUATION_PROVIDER=claude

# SIMULATION
SIMULATION_MAX_DURATION_MINUTES=15
SIMULATION_MAX_CONCURRENT_PER_USER=1
ENABLE_CLAUDE_LIVE_DELEGATION=false
ENABLE_AUDIO_RECORDING=false

# COST CONTROL (valeur d'exemple configurable ; tarifs dans apps/api/config/pricing.json)
ENABLE_USAGE_TRACKING=true
MAX_SESSION_ESTIMATED_COST_USD=2.00
ORG_MONTHLY_SESSION_QUOTA=500
TRANSCRIPT_RETENTION_DAYS=90

# CACHE (configuré, pas encore utilisé par le code MVP)
VALKEY_URL=

# FRONTEND (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=
NEXT_PUBLIC_KEYCLOAK_REALM=
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=
